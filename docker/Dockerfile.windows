# escape=`
FROM python:3.13-windowsservercore-ltsc2022
SHELL ["cmd", "/S", "/C"]
WORKDIR C:\src
COPY . .
ENV WEBSQLMAPPER_INSTALL_ROOT=C:\WebSQLMapperTest
ENV WEBSQLMAPPER_SKIP_PATH=1
RUN call scripts\install.cmd
RUN call C:\WebSQLMapperTest\bin\websqlmapper.cmd --version
RUN call C:\WebSQLMapperTest\bin\websqlmapper.cmd --color never doctor
